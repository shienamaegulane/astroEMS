@model IEnumerable<astroEMS.Models.COERequest>

@{
    ViewData["Title"] = "COE Requests";
    var requestCount = Model.Count();
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Employee documents</p>
            <h1>Certificate of Employment Requests</h1>
            <p class="dashboard-intro-description">
                Review requests and issue approved certificates.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
            @requestCount request@(requestCount == 1 ? "" : "s")
        </p>
    </header>

    <section class="card dashboard-panel" aria-labelledby="coe-requests-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <div>
                    <h2 id="coe-requests-heading">Request directory</h2>
                    <p>Open a request to review its details and status.</p>
                </div>
            </div>
        </div>

        @if (requestCount == 0)
        {
            <div class="dashboard-empty py-5">
                <i class="bi bi-file-earmark-text fs-2 d-block mb-2" aria-hidden="true"></i>
                No COE requests have been submitted.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Employee</th>
                            <th scope="col">Purpose</th>
                            <th scope="col">Date requested</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details"
                                       asp-route-id="@r.RequestID"
                                       class="fw-semibold text-decoration-none">
                                        @r.Employee?.FirstName @r.Employee?.LastName
                                    </a>
                                </td>
                                <td>@r.Purpose</td>
                                <td>@r.DateRequested.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @{
                                        string cls = r.Status switch
                                        {
                                            "Approved" => "badge-active",
                                            "Rejected" => "badge-absent",
                                            _ => "badge-late"
                                        };
                                    }
                                    <span class="badge @cls">@r.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                        <a asp-action="Details"
                                           asp-route-id="@r.RequestID"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye me-1" aria-hidden="true"></i>
                                            View
                                        </a>

                                        @if (r.Status == "Pending")
                                        {
                                            <form asp-action="Approve"
                                                  asp-route-id="@r.RequestID"
                                                  method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                                    Approve
                                                </button>
                                            </form>

                                            <form asp-action="Reject"
                                                  asp-route-id="@r.RequestID"
                                                  method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-lg me-1" aria-hidden="true"></i>
                                                    Reject
                                                </button>
                                            </form>
                                        }
                                        else if (r.Status == "Approved")
                                        {
                                            <a asp-action="Print"
                                               asp-route-id="@r.RequestID"
                                               class="btn btn-sm btn-outline-primary"
                                               target="coePrintWindow"
                                               aria-label="View or print certificate for @r.Employee?.FirstName @r.Employee?.LastName">
                                                <i class="bi bi-printer" aria-hidden="true"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>