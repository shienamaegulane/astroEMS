@model IEnumerable<astroEMS.Models.COERequest>
@{
    ViewData["Title"] = "Certificate of Employment";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<h3 class="mb-4"><i class="bi bi-file-earmark-text me-2"></i>Certificate of Employment (COE)</h3>

<div class="card mb-4" style="max-width:500px;">
    <div class="card-header">Request a New COE</div>
    <div class="card-body">
        <form asp-action="Request" method="post">
            <div class="mb-3">
                <label class="form-label">Purpose</label>
                <input type="text" name="purpose" class="form-control" placeholder="e.g. Visa application, loan requirement" required />
            </div>
            <button type="submit" class="btn btn-gold">Submit Request</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">My Request History</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#F5F7FA;">
                <tr>
                    <th class="ps-4">Date Requested</th>
                    <th>Purpose</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-4">@r.DateRequested.ToString("MMM dd, yyyy")</td>
                        <td>@r.Purpose</td>
                        <td>
                            @{
                                string cls = r.Status switch { "Approved" => "badge-active", "Rejected" => "badge-absent", _ => "badge-late" };
                            }
                            <span class="badge @cls">@r.Status</span>
                        </td>
                        <td class="text-end pe-4">
                            @if (r.Status == "Approved")
                            {
                                <a asp-action="Print" asp-route-id="@r.RequestID" class="btn btn-sm btn-outline-primary" target="coePrintWindow">
                                    <i class="bi bi-printer"></i> View / Print
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>