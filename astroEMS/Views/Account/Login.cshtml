@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="astro-login-shell">
    <div class="astro-login-card">
        <div class="astro-login-card-inner">

            <div class="astro-login-brand">
                <div class="astro-login-logo">
                    <svg viewBox="0 0 48 48"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg"
                         aria-hidden="true"
                         focusable="false">

                        <defs>
                            <linearGradient id="goldGrad"
                                            gradientUnits="userSpaceOnUse"
                                            x1="15" y1="12"
                                            x2="33" y2="32">
                                <stop stop-color="#FFF2BF" />
                                <stop offset="0.5" stop-color="#D4AF37" />
                                <stop offset="1" stop-color="#9A751E" />
                            </linearGradient>
                        </defs>

                        <polygon points="24,4 42,16 42,32 24,44 6,32 6,16"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 opacity="0.6" />

                        <path d="M24 12L33 32H15L24 12Z"
                              stroke="url(#goldGrad)"
                              stroke-width="2.5"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                        <line x1="18" y1="26"
                              x2="30" y2="26"
                              stroke="#E5C158"
                              stroke-width="2" />

                        <circle cx="24" cy="24" r="17"
                                stroke="#D4AF37"
                                stroke-width="1.2"
                                stroke-dasharray="3 4"
                                stroke-opacity="0.8" />
                    </svg>
                </div>

                <h1 class="astro-login-title">Astro EMS Login</h1>

                <p class="astro-login-subtitle">
                    Attendance &amp; Payroll Management
                </p>

                <p class="astro-login-description">
                    Secure sign-in for timesheets, attendance verification,
                    and enterprise employee self-service.
                </p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger astro-login-error" role="alert">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Login"
                  asp-antiforgery="true"
                  method="post"
                  class="astro-login-form">

                <div class="astro-login-field">
                    <label for="username"
                           class="form-label astro-login-label">
                        Username
                    </label>

                    <div class="astro-login-input-wrap">
                        <svg class="astro-login-input-icon"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true"
                             focusable="false">
                            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>

                        <input type="text"
                               id="username"
                               name="username"
                               class="form-control astro-login-input"
                               placeholder="Employee ID or username"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               required />
                    </div>
                </div>

                <div class="astro-login-field">
                    <label for="password"
                           class="form-label astro-login-label">
                        Password
                    </label>

                    <div class="astro-login-input-wrap">
                        <svg class="astro-login-input-icon"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true"
                             focusable="false">
                            <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>

                        <input type="password"
                               id="password"
                               name="password"
                               class="form-control astro-login-input astro-login-input-password"
                               placeholder="Enter your confidential password"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                id="togglePasswordBtn"
                                class="astro-login-toggle"
                                aria-label="Show password"
                                aria-controls="password"
                                hidden>

                            <svg id="eyeOpenIcon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true"
                                 focusable="false">
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>

                            <svg id="eyeClosedIcon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true"
                                 focusable="false"
                                 hidden>
                                <path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100 astro-login-submit">
                    <span>Login</span>

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true"
                         focusable="false">
                        <path d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("togglePasswordBtn");
            const passwordInput = document.getElementById("password");
            const eyeOpen = document.getElementById("eyeOpenIcon");
            const eyeClosed = document.getElementById("eyeClosedIcon");

            if (!toggleBtn || !passwordInput || !eyeOpen || !eyeClosed) {
                return;
            }

            toggleBtn.addEventListener("click", function () {
                const isPassword = passwordInput.type === "password";

                passwordInput.type = isPassword ? "text" : "password";

                toggleBtn.setAttribute(
                    "aria-label",
                    isPassword ? "Hide password" : "Show password"
                );

                eyeOpen.hidden = isPassword;
                eyeClosed.hidden = !isPassword;
            });

            toggleBtn.hidden = false;
        });
    </script>
}