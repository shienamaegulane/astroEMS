@inject astroEMS.Data.AppDbContext DbContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Astro Shipmanagement</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @{
        bool isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        int pendingCOECount = 0;
        var topbarAlerts = new List<string>();

        if (isLoggedIn)
        {
            if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                pendingCOECount = DbContext.COERequests.Count(r => r.Status == "Pending");

                int missingGovIds = DbContext.Employees.Count(e =>
                string.IsNullOrEmpty(e.SSSNumber) || string.IsNullOrEmpty(e.PhilHealthNumber) ||
                string.IsNullOrEmpty(e.PagIBIGNumber) || string.IsNullOrEmpty(e.TINNumber));
                if (missingGovIds > 0)
                    topbarAlerts.Add($"{missingGovIds} employee(s) have incomplete government ID information.");

                if (pendingCOECount > 0)
                    topbarAlerts.Add($"{pendingCOECount} COE request(s) awaiting HR review.");

                int pendingPayroll = DbContext.PayrollPeriods.Count(p => p.Status == "PendingApproval");
                if (pendingPayroll > 0)
                    topbarAlerts.Add($"{pendingPayroll} payroll period(s) awaiting Admin approval.");
            }
            else
            {
                var employeeIdClaim = User.FindFirst("EmployeeID")?.Value;
                if (employeeIdClaim != null)
                {
                    int employeeId = int.Parse(employeeIdClaim);
                    var me = DbContext.Employees.Find(employeeId);

                    if (me != null)
                    {
                        var missingFields = new List<string>();
                        if (string.IsNullOrEmpty(me.SSSNumber)) missingFields.Add("SSS");
                        if (string.IsNullOrEmpty(me.PhilHealthNumber)) missingFields.Add("PhilHealth");
                        if (string.IsNullOrEmpty(me.PagIBIGNumber)) missingFields.Add("Pag-IBIG");
                        if (string.IsNullOrEmpty(me.TINNumber)) missingFields.Add("TIN");

                        if (missingFields.Any())
                            topbarAlerts.Add($"Your {string.Join(", ", missingFields)} information is incomplete. Please coordinate with HR.");

                        int myPendingCOE = DbContext.COERequests.Count(r => r.EmployeeID == employeeId && r.Status == "Pending");
                        if (myPendingCOE > 0)
                            topbarAlerts.Add($"You have {myPendingCOE} COE request(s) pending review.");
                    }
                }
            }
        }
    }

    @if (isLoggedIn)
    {
        <div class="sidebar">
            <div class="sidebar-brand d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="sidebar-brand-logo">
                        <svg viewBox="0 0 48 48"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg"
                             aria-hidden="true"
                             focusable="false">
                            <defs>
                                <linearGradient id="sidebarGoldGrad"
                                                gradientUnits="userSpaceOnUse"
                                                x1="15" y1="12"
                                                x2="33" y2="32">
                                    <stop stop-color="#FFF2BF" />
                                    <stop offset="0.5" stop-color="#D4AF37" />
                                    <stop offset="1" stop-color="#9A751E" />
                                </linearGradient>
                            </defs>

                            <polygon points="24,4 42,16 42,32 24,44 6,32 6,16"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     opacity="0.6" />

                            <path d="M24 12L33 32H15L24 12Z"
                                  stroke="url(#sidebarGoldGrad)"
                                  stroke-width="2.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />

                            <line x1="18" y1="26"
                                  x2="30" y2="26"
                                  stroke="#E5C158"
                                  stroke-width="2" />

                            <circle cx="24" cy="24" r="17"
                                    stroke="#D4AF37"
                                    stroke-width="1.2"
                                    stroke-dasharray="3 4"
                                    stroke-opacity="0.8" />
                        </svg>
                    </div>
                    <span>Astro Shipmanagement</span>
                </div>
                <button class="btn-sidebar-close d-lg-none" id="sidebarCloseBtn">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <ul class="sidebar-nav">
                <li><a class="@(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
                <li><a class="@(currentController == "Employees" ? "active" : "")" asp-controller="Employees" asp-action="Index"><i class="bi bi-people"></i> Employees</a></li>
                @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                {
                    <li>
                        <a class="@(currentController == "COE" ? "active" : "") d-flex justify-content-between align-items-center"
                           asp-controller="COE" asp-action="Index">
                            <span><i class="bi bi-file-earmark-check"></i> COE Requests (HR)</span>
                            @if (pendingCOECount > 0)
                            {
                                <span class="badge bg-danger rounded-pill">@pendingCOECount</span>
                            }
                        </a>
                    </li>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                {
                    <li><a class="@(currentController == "Departments" ? "active" : "")" asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3"></i> Departments</a></li>
                    <li><a class="@(currentController == "Positions" ? "active" : "")" asp-controller="Positions" asp-action="Index"><i class="bi bi-briefcase"></i> Positions</a></li>
                }

                <li><a class="@(currentController == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Index"><i class="bi bi-calendar-check"></i> Attendance</a></li>
                @* @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                {
                    <li><a asp-controller="Attendance" asp-action="Summary"><i class="bi bi-bar-chart-line"></i> Attendance Summary</a></li>
                } *@
                @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                {
                    <li><a class="@(currentController == "Payroll" ? "active" : "")" asp-controller="Payroll" asp-action="Index"><i class="bi bi-cash-stack"></i> Payroll</a></li>
                }
                else
                {
                    <li><a class="@(currentController == "Payroll" ? "active" : "")" asp-controller="Payroll" asp-action="MyPayslips"><i class="bi bi-cash-stack"></i> My Payslips</a></li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                {
                    <li><a class="@(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i> Reports</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li><a class="@(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="bi bi-shield-lock"></i> User Accounts</a></li>
                }
                <li><a class="@(currentController == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i> My Profile</a></li>
                @*        <li><a href="#"><i class="bi bi-gear"></i> Settings</a></li> *@
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
            </div>
        </div>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    }

    <div class="main-content" style="@(isLoggedIn ? "" : "margin-left:0;")">
        @if (isLoggedIn)
        {
            <div class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sidebar-toggle d-lg-none" id="sidebarToggleBtn">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <button class="btn-bell" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell"></i>
                            @if (topbarAlerts.Any())
                            {
                                <span class="badge bg-danger rounded-pill bell-badge">@topbarAlerts.Count</span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end alert-dropdown">
                            <li><h6 class="dropdown-header">Notifications</h6></li>
                            @if (!topbarAlerts.Any())
                            {
                                <li><span class="dropdown-item-text text-muted small">No alerts right now.</span></li>
                            }
                            else
                            {
                                foreach (var alert in topbarAlerts)
                                {
                                    <li><span class="dropdown-item-text small">@alert</span></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                            }
                        </ul>
                    </div>

                    <span class="greeting">Hello, @User.Identity!.Name</span>
                    <span class="role-badge">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
            </div>
        }

        <div class="page-content">
            @RenderBody()
        </div>

        <footer class="border-top footer text-muted py-3 px-4">
            &copy; 2026 - Astro EMS - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const sidebar = document.querySelector('.sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggleBtn = document.getElementById('sidebarToggleBtn');
        const closeBtn = document.getElementById('sidebarCloseBtn');

        function openSidebar() {
            sidebar?.classList.add('show');
            overlay?.classList.add('show');
        }

        function closeSidebar() {
            sidebar?.classList.remove('show');
            overlay?.classList.remove('show');
        }

        toggleBtn?.addEventListener('click', openSidebar);
        closeBtn?.addEventListener('click', closeSidebar);
        overlay?.addEventListener('click', closeSidebar);
    </script>
</body>
</html>