@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">System notice</p>
            <h1>Something went wrong</h1>
            <p class="dashboard-intro-description">
                We couldn’t complete your request. Please try again.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            Error
        </p>
    </header>

    <section class="card dashboard-panel" style="max-width: 640px;" aria-labelledby="error-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <div>
                    <h2 id="error-heading">Request unsuccessful</h2>
                    <p>Your changes may not have been saved.</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <p class="mb-4">
                Try the action again. If the problem continues, share the request ID
                below with your system administrator.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mb-4">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-gold">
                <i class="bi bi-house me-1" aria-hidden="true"></i>
                Back to Dashboard
            </a>
        </div>
    </section>
</div>