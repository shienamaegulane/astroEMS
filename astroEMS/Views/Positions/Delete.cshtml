@model astroEMS.Models.Position

@{
    ViewData["Title"] = "Delete Position";
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Organization</p>
            <h1>Delete Position</h1>
            <p class="dashboard-intro-description">
                Confirm that you want to remove this position.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-briefcase" aria-hidden="true"></i>
            Positions
        </p>
    </header>

    <section class="card dashboard-panel" style="max-width: 640px;" aria-labelledby="delete-position-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-exclamation-triangle text-danger" aria-hidden="true"></i>
                <div>
                    <h2 id="delete-position-heading">Delete @Model.Name?</h2>
                    <p>Please review before confirming.</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <p class="mb-4">
                Are you sure you want to delete <strong>@Model.Name</strong>?
            </p>

            <form asp-action="Delete"
                  asp-route-positionid="@Model.PositionID"
                  method="post"
                  asp-antiforgery="true"
                  class="d-flex flex-wrap gap-2">
                <input type="hidden" name="positionid" value="@Model.PositionID" />
                <button type="submit" class="btn btn-danger">
                    Delete Position
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </section>
</div>