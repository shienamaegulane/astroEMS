@model IEnumerable<astroEMS.Models.Position>
@{
    ViewData["Title"] = "Positions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-briefcase me-2"></i>Positions</h3>
    <a asp-action="Create" class="btn btn-gold"><i class="bi bi-plus-lg"></i> Add Position</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#F5F7FA;">
                <tr>
                    <th class="ps-4">Position Name</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">@item.Name</td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-positionid="@item.PositionID" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-positionid="@item.PositionID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>