@model astroEMS.Models.Position

@{
    ViewData["Title"] = "Position Details";
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Organization</p>
            <h1>Position Details</h1>
            <p class="dashboard-intro-description">
                View this position’s information.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-briefcase" aria-hidden="true"></i>
            Positions
        </p>
    </header>

    <section class="card dashboard-panel" style="max-width: 640px;" aria-labelledby="position-details-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-briefcase" aria-hidden="true"></i>
                <div>
                    <h2 id="position-details-heading">@Model.Name</h2>
                    <p>Position record</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Position name</dt>
                <dd class="col-sm-8 fw-semibold mb-0">@Model.Name</dd>
            </dl>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Edit"
                   asp-route-positionid="@Model.PositionID"
                   class="btn btn-gold">
                    <i class="bi bi-pencil me-1" aria-hidden="true"></i>
                    Edit Position
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Back to Positions
                </a>
            </div>
        </div>
    </section>
</div>