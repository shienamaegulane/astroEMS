@model IEnumerable<astroEMS.Models.User>
@{
    ViewData["Title"] = "User Accounts";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<h3 class="mb-4"><i class="bi bi-shield-lock me-2"></i>User Accounts</h3>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#F5F7FA;">
                <tr>
                    <th class="ps-4">Employee</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="ps-4">@u.Employee?.FirstName @u.Employee?.LastName</td>
                        <td>@u.Username</td>
                        <td>
                            <form asp-action="ChangeRole" method="post" class="d-inline-flex gap-1">
                                <input type="hidden" name="userId" value="@u.UserID" />
                                <select name="newRole" class="form-select form-select-sm" style="width:auto;">
                                    <option value="Employee" selected="@(u.Role == "Employee")">Employee</option>
                                    <option value="HR" selected="@(u.Role == "HR")">HR</option>
                                    <option value="Admin" selected="@(u.Role == "Admin")">Admin</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "badge-active" : "badge-absent")">
                                @(u.IsActive ? "Active" : "Disabled")
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <form asp-action="ToggleActive" asp-route-id="@u.UserID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(u.IsActive ? "Disable" : "Enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>