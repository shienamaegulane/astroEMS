@model IEnumerable<astroEMS.Models.Department>

@{
    ViewData["Title"] = "Departments";
    var departmentCount = Model.Count();
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Organization</p>
            <h1>Departments</h1>
            <p class="dashboard-intro-description">
                Manage the departments used across employee records.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-diagram-3" aria-hidden="true"></i>
            @departmentCount department@(departmentCount == 1 ? "" : "s")
        </p>
    </header>

    <section class="card dashboard-panel" aria-labelledby="departments-heading">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="dashboard-panel-header">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                <div>
                    <h2 id="departments-heading">Department directory</h2>
                    <p>View and maintain your organization’s departments.</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-gold">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                Add Department
            </a>
        </div>

        @if (departmentCount == 0)
        {
            <div class="dashboard-empty py-5">
                <i class="bi bi-building fs-2 d-block mb-2" aria-hidden="true"></i>
                No departments have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Department name</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                        <a asp-action="Details"
                                           asp-route-departmentid="@item.DepartmentID"
                                           class="btn btn-sm btn-outline-secondary"
                                           aria-label="View @item.Name details"
                                           title="View details">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-departmentid="@item.DepartmentID"
                                           class="btn btn-sm btn-outline-primary"
                                           aria-label="Edit @item.Name"
                                           title="Edit">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteDepartmentModal-@item.DepartmentID"
                                                aria-label="Delete @item.Name"
                                                title="Delete">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @foreach (var item in Model)
            {
                <div class="modal fade"
                     id="deleteDepartmentModal-@item.DepartmentID"
                     tabindex="-1"
                     aria-labelledby="deleteDepartmentTitle-@item.DepartmentID"
                     aria-describedby="deleteDepartmentDescription-@item.DepartmentID"
                     aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="deleteDepartmentTitle-@item.DepartmentID">
                                    Delete department
                                </h2>
                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body" id="deleteDepartmentDescription-@item.DepartmentID">
                                Are you sure you want to delete <strong>@item.Name</strong>?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Cancel
                                </button>
                                <form asp-action="Delete"
                                      asp-route-departmentid="@item.DepartmentID"
                                      method="post"
                                      asp-antiforgery="true">
                                    <input type="hidden" name="departmentid" value="@item.DepartmentID" />
                                    <button type="submit" class="btn btn-danger">
                                        Delete department
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</div>