@model IEnumerable<astroEMS.Models.Attendance>
@{
    ViewData["Title"] = "Today's Attendance";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Today's Attendance</h3>
        <p class="text-muted mb-0">@(((DateTime)ViewBag.Today).ToString("dddd, MMMM dd, yyyy"))</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
    {
        <div class="d-flex gap-2">
            <a asp-action="Summary" class="btn btn-outline-secondary">
                <i class="bi bi-bar-chart-line"></i> View History / Summary
            </a>
            <a asp-action="Import" class="btn btn-gold">
                <i class="bi bi-upload"></i> Import Attendance
            </a>
        </div>
    }
</div>

@if (User.IsInRole("Admin") || User.IsInRole("HR"))
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Present Today</div>
                    <div class="fs-3 fw-bold text-success">@ViewBag.PresentCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Late Today</div>
                    <div class="fs-3 fw-bold" style="color:#F9A825;">@ViewBag.LateCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Absent Today</div>
                    <div class="fs-3 fw-bold text-danger">@ViewBag.AbsentCount</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#F5F7FA;">
                <tr>
                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                    {
                        <th class="ps-4">Employee</th>
                    }
                    <th>Time In</th>
                    <th>Lunch Out</th>
                    <th>Lunch In</th>
                    <th>Time Out</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No attendance record for today yet.</td>
                    </tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                        {
                            <td class="ps-4">@a.Employee?.FirstName @a.Employee?.LastName</td>
                        }
                        <td>@(a.TimeIn.HasValue ? DateTime.Today.Add(a.TimeIn.Value).ToString("h:mm tt") : "-")</td>
                        <td>@(a.LunchOut.HasValue ? DateTime.Today.Add(a.LunchOut.Value).ToString("h:mm tt") : "-")</td>
                        <td>@(a.LunchIn.HasValue ? DateTime.Today.Add(a.LunchIn.Value).ToString("h:mm tt") : "-")</td>
                        <td>@(a.TimeOut.HasValue ? DateTime.Today.Add(a.TimeOut.Value).ToString("h:mm tt") : "-")</td>
                        <td>
                            @{
                                string cls = a.Status switch
                                {
                                    "Present" => "badge-active",
                                    "Late" => "badge-late",
                                    "Half Day" => "badge-halfday",
                                    _ => "badge-absent"
                                };
                            }
                            <span class="badge @cls">@a.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>