@model IEnumerable<astroEMS.Models.AttendanceSummaryRow>
@{
    ViewData["Title"] = "Attendance Summary";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-bar-chart-line me-2"></i>Attendance Summary</h3>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back to Today's Attendance
    </a>
</div>

<div class="card mb-4">
    <div class="card-body py-2">
        <form asp-action="Summary" method="get" class="d-flex gap-2 align-items-center">
            <label class="mb-0 small text-muted">From</label>
            <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" style="max-width:170px;" />
            <label class="mb-0 small text-muted">To</label>
            <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" style="max-width:170px;" />
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#F5F7FA;">
                <tr>
                    <th class="ps-4">Employee</th>
                    <th>Department</th>
                    <th class="text-center">Present</th>
                    <th class="text-center">Late</th>
                    <th class="text-center">Absent</th>
                    <th class="text-center">OT Hours</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-semibold">@row.EmployeeName</div>
                            <div class="text-muted small">@row.EmployeeNumber</div>
                        </td>
                        <td>@row.Department</td>
                        <td class="text-center"><span class="badge badge-active">@row.PresentCount</span></td>
                        <td class="text-center"><span class="badge badge-late">@row.LateCount</span></td>
                        <td class="text-center"><span class="badge badge-absent">@row.AbsentCount</span></td>
                        <td class="text-center">@row.TotalOTHours.ToString("0.#") hrs</td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-employeeId="@row.EmployeeID"
                               asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>