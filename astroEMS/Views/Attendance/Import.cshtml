@{
    ViewData["Title"] = "Import Attendance";
}

<h3 class="mb-4"><i class="bi bi-upload me-2"></i>Import Attendance</h3>

<div class="card mb-4" style="max-width:500px;">
    <div class="card-body">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <p class="text-muted small">
            Upload a CSV or Excel (.xlsx) file exported from your time-tracking device — one row per scan.
            Columns, in order: <strong>EmployeeNumber, Date, Time</strong>.
            The system automatically detects Time In, Lunch Out, Lunch In, and Time Out based on scan order per employee per day
            (2 scans = Time In/Out only, 4 scans = full day with lunch break).
        </p>
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <input type="file" name="file" class="form-control" accept=".csv,.xlsx" required />
            </div>
            <button type="submit" class="btn btn-gold"><i class="bi bi-upload"></i> Import File</button>
        </form>
    </div>
</div>