@{
    ViewData["Title"] = "Generate Payroll";
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Compensation</p>
            <h1>Generate Payroll</h1>
            <p class="dashboard-intro-description">
                Select the payroll period and scheduled pay date.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-calendar-range" aria-hidden="true"></i>
            Payroll period
        </p>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <section class="card dashboard-panel" style="max-width: 680px;" aria-labelledby="generate-payroll-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-cash-stack" aria-hidden="true"></i>
                <div>
                    <h2 id="generate-payroll-heading">Payroll details</h2>
                    <p>Enter the period covered and the date employees will be paid.</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="GeneratePayroll" method="post">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label for="periodStart" class="form-label fw-semibold">Period Start</label>
                        <input id="periodStart"
                               type="date"
                               name="periodStart"
                               class="form-control"
                               required />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label for="periodEnd" class="form-label fw-semibold">Period End</label>
                        <input id="periodEnd"
                               type="date"
                               name="periodEnd"
                               class="form-control"
                               required />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="payDate" class="form-label fw-semibold">Pay Date</label>
                    <input id="payDate"
                           type="date"
                           name="payDate"
                           class="form-control"
                           required />
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-gold">
                        <i class="bi bi-gear me-1" aria-hidden="true"></i>
                        Generate Payroll
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </section>
</div>