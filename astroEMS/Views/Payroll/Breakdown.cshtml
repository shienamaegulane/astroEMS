@model IEnumerable<astroEMS.Models.Payslip>

@{
    ViewData["Title"] = "Payroll Breakdown";
    var period = ViewBag.Period as astroEMS.Models.PayrollPeriod;
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Compensation</p>
            <h1>Payroll Breakdown</h1>
            <p class="dashboard-intro-description">
                @period?.PeriodStart.ToString("MMM dd, yyyy") – @period?.PeriodEnd.ToString("MMM dd, yyyy")
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-shield-check" aria-hidden="true"></i>
            Status:
            <span class="badge @(period?.Status == "Approved" ? "badge-active" : "badge-late")">
                @period?.Status
            </span>
        </p>
    </header>

    <section class="card dashboard-panel" aria-labelledby="payroll-breakdown-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-table" aria-hidden="true"></i>
                <div>
                    <h2 id="payroll-breakdown-heading">Employee pay breakdown</h2>
                    <p>Salary, work days, deductions, and net pay for this period.</p>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4">Employee</th>
                        <th scope="col">Basic Salary</th>
                        <th scope="col">Daily Rate</th>
                        <th scope="col">Work Days</th>
                        <th scope="col">Gross Pay</th>
                        <th scope="col">PhilHealth</th>
                        <th scope="col">SSS</th>
                        <th scope="col">Pag-IBIG</th>
                        <th scope="col" class="pe-4">Net Pay</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="dashboard-empty py-5">
                                No payslips found for this payroll period.
                            </td>
                        </tr>
                    }

                    @foreach (var p in Model)
                    {
                        decimal dailyRate = (p.Employee?.BasicSalary ?? 0) / 22;
                        int workDays = p.DaysPresent + p.DaysLate;

                        <tr>
                            <td class="ps-4 fw-semibold">@p.Employee?.FirstName @p.Employee?.LastName</td>
                            <td>₱@p.Employee?.BasicSalary.ToString("N2")</td>
                            <td>₱@dailyRate.ToString("N2")</td>
                            <td>@workDays</td>
                            <td>₱@p.GrossPay.ToString("N2")</td>
                            <td>₱@p.PhilHealthDeduction.ToString("N2")</td>
                            <td>₱@p.SSSDeduction.ToString("N2")</td>
                            <td>₱@p.PagIBIGDeduction.ToString("N2")</td>
                            <td class="pe-4 fw-semibold">₱@p.NetPay.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (period?.Status == "PendingApproval" && User.IsInRole("Admin"))
        {
            <form asp-action="Approve" method="post">
                <input type="hidden" name="periodId" value="@period.PeriodID" />
                <button type="submit"
                        class="btn btn-gold"
                        onclick="return confirm('Approve this payroll? Employees will be able to view their payslips.');">
                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                    Approve Payroll
                </button>
            </form>
        }

        @if (period?.Status == "PendingApproval" && User.IsInRole("HR") && !User.IsInRole("Admin"))
        {
            <div class="alert alert-info mb-0 py-2 px-3" role="status">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                Waiting for Admin approval.
            </div>
        }

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back to Payroll List
        </a>
    </div>
</div>