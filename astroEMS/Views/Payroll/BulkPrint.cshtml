@model IEnumerable<astroEMS.Models.Payslip>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Payslips</title>
    <style>
            body {
                font-family: 'Segoe UI', sans-serif;
                color: #1a1a1a;
            }

            .payslip {
                max-width: 600px;
                margin: 40px auto;
                padding: 20px;
                page-break-after: always;
            }

            .header {
                text-align: center;
                margin-bottom: 20px;
            }

                .header h2 {
                    margin: 0;
                    color: #0A2540;
                }

                .header p {
                    margin: 2px 0;
                    color: #555;
                    font-size: 0.85rem;
                }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 15px;
            }

            td {
                padding: 5px 4px;
                font-size: 0.88rem;
            }

            .section-title {
                font-weight: bold;
                background: #F5F7FA;
                padding: 5px 8px;
                margin-top: 10px;
            }

            .right {
                text-align: right;
            }

            .total-row td {
                border-top: 2px solid #333;
                font-weight: bold;
            }

            .net-pay {
                background: #0A2540;
                color: white;
                padding: 10px;
                text-align: center;
                font-size: 1.1rem;
                font-weight: bold;
                border-radius: 6px;
                margin-top: 10px;
            }

            .print-btn {
                text-align: center;
                margin: 20px;
            }

            @@media print {
                .print-btn {
                    display: none;
                }
            }
    </style>
</head>
<body>
    <div class="print-btn"><button onclick="window.print()">🖨️ Print All Payslips</button></div>

    @foreach (var Model in ((IEnumerable<astroEMS.Models.Payslip>)ViewData.Model))
    {
        <div class="payslip">
            <div class="header">
                <h2>ASTRO SHIPMANAGEMENT, INC.</h2>
                <p>6F Skyrise 1 Bldg., Cebu IT Park, Apas, Cebu City</p>
                <p>PAYSLIP</p>
            </div>
            <table>
                <tr><td><strong>Employee:</strong></td><td class="right">@Model.Employee?.FirstName @Model.Employee?.LastName</td></tr>
                <tr><td><strong>Employee No.:</strong></td><td class="right">@Model.Employee?.EmployeeNumber</td></tr>
                <tr><td><strong>Pay Period:</strong></td><td class="right">@Model.Period?.PeriodStart.ToString("MMM dd") - @Model.Period?.PeriodEnd.ToString("MMM dd, yyyy")</td></tr>
            </table>
            <div class="section-title">EARNINGS</div>
            <table>
                <tr><td>Basic Pay</td><td class="right">₱@Model.BasicPay.ToString("N2")</td></tr>
                <tr><td>Overtime Pay</td><td class="right">₱@Model.OvertimePay.ToString("N2")</td></tr>
                <tr class="total-row"><td>GROSS PAY</td><td class="right">₱@Model.GrossPay.ToString("N2")</td></tr>
            </table>
            <div class="section-title">DEDUCTIONS</div>
            <table>
                <tr><td>Late Deduction</td><td class="right">₱@Model.LateDeduction.ToString("N2")</td></tr>
                <tr><td>Undertime Deduction</td><td class="right">₱@Model.UndertimeDeduction.ToString("N2")</td></tr>
                <tr><td>SSS</td><td class="right">₱@Model.SSSDeduction.ToString("N2")</td></tr>
                <tr><td>PhilHealth</td><td class="right">₱@Model.PhilHealthDeduction.ToString("N2")</td></tr>
                <tr><td>Pag-IBIG</td><td class="right">₱@Model.PagIBIGDeduction.ToString("N2")</td></tr>
                <tr><td>Withholding Tax</td><td class="right">₱@Model.WithholdingTax.ToString("N2")</td></tr>
                <tr class="total-row"><td>TOTAL DEDUCTIONS</td><td class="right">₱@Model.TotalDeductions.ToString("N2")</td></tr>
            </table>
            <div class="net-pay">NET PAY: ₱@Model.NetPay.ToString("N2")</div>
        </div>
    }
</body>
</html>