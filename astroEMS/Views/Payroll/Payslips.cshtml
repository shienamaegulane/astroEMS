@model IEnumerable<astroEMS.Models.Payslip>
@{
    ViewData["Title"] = "Payslips";
    var period = ViewBag.Period as astroEMS.Models.PayrollPeriod;
}

<h3 class="mb-1"><i class="bi bi-cash-stack me-2"></i>Payslips</h3>
<p class="text-muted mb-4">@period?.PeriodStart.ToString("MMM dd") - @period?.PeriodEnd.ToString("MMM dd, yyyy")</p>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#F5F7FA;">
                <tr>
                    <th class="ps-4">Employee</th>
                    <th>Gross Pay</th>
                    <th>Deductions</th>
                    <th>Net Pay</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4">@p.Employee?.FirstName @p.Employee?.LastName</td>
                        <td>₱@p.GrossPay.ToString("N2")</td>
                        <td>₱@p.TotalDeductions.ToString("N2")</td>
                        <td class="fw-semibold">₱@p.NetPay.ToString("N2")</td>
                        <td class="text-end pe-4">
                            <a asp-action="View" asp-route-id="@p.PayslipID" class="btn btn-sm btn-outline-primary" target="payslipWindow">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-3">
    <i class="bi bi-arrow-left"></i> Back to Payroll Periods
</a>