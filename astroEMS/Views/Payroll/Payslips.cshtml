@model IEnumerable<astroEMS.Models.Payslip>

@{
    ViewData["Title"] = "Payslips";
    var period = ViewBag.Period as astroEMS.Models.PayrollPeriod;
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Compensation</p>
            <h1>Payslips</h1>
            <p class="dashboard-intro-description">
                Review employee payslips for this payroll period.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-calendar-range" aria-hidden="true"></i>
            @period?.PeriodStart.ToString("MMM dd") – @period?.PeriodEnd.ToString("MMM dd, yyyy")
        </p>
    </header>

    <section class="card dashboard-panel" aria-labelledby="payslips-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-receipt" aria-hidden="true"></i>
                <div>
                    <h2 id="payslips-heading">Employee payslips</h2>
                    <p>Gross pay, deductions, and net pay for the selected period.</p>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4">Employee</th>
                        <th scope="col">Gross Pay</th>
                        <th scope="col">Deductions</th>
                        <th scope="col">Net Pay</th>
                        <th scope="col" class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="dashboard-empty py-5">
                                No payslips found for this period.
                            </td>
                        </tr>
                    }

                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@p.Employee?.FirstName @p.Employee?.LastName</td>
                            <td>₱@p.GrossPay.ToString("N2")</td>
                            <td>₱@p.TotalDeductions.ToString("N2")</td>
                            <td class="fw-semibold">₱@p.NetPay.ToString("N2")</td>
                            <td class="text-end pe-4">
                                <a asp-action="View"
                                   asp-route-id="@p.PayslipID"
                                   class="btn btn-sm btn-outline-primary"
                                   target="payslipWindow">
                                    <i class="bi bi-eye me-1" aria-hidden="true"></i>
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back to Payroll Periods
        </a>
    </div>
</div>