@model IEnumerable<astroEMS.Models.Payslip>

@{
    ViewData["Title"] = "My Payslips";
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">My Payroll</p>
            <h1>My Payslips</h1>
            <p class="dashboard-intro-description">
                View your pay periods and open a payslip for printing.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-receipt" aria-hidden="true"></i>
            Payslip history
        </p>
    </header>

    <section class="card dashboard-panel" aria-labelledby="my-payslips-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-cash-stack" aria-hidden="true"></i>
                <div>
                    <h2 id="my-payslips-heading">Available payslips</h2>
                    <p>Select a pay period to view or print its payslip.</p>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4">Pay Period</th>
                        <th scope="col">Net Pay</th>
                        <th scope="col" class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="dashboard-empty py-5">
                                No payslips yet.
                            </td>
                        </tr>
                    }

                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                @p.Period?.PeriodStart.ToString("MMM dd") - @p.Period?.PeriodEnd.ToString("MMM dd, yyyy")
                            </td>
                            <td class="fw-semibold">₱@p.NetPay.ToString("N2")</td>
                            <td class="text-end pe-4">
                                <a asp-action="View"
                                   asp-route-id="@p.PayslipID"
                                   class="btn btn-sm btn-outline-primary"
                                   target="payslipWindow">
                                    <i class="bi bi-eye me-1" aria-hidden="true"></i>
                                    View / Print
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>