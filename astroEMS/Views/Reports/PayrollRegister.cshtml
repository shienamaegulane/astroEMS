@model IEnumerable<astroEMS.Models.Payslip>
@{
    ViewData["Title"] = "Payroll Register";
    var periods = ViewBag.Periods as List<astroEMS.Models.PayrollPeriod>;
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Reports</p>
            <h1>Payroll Register</h1>
            <p class="dashboard-intro-description">
                Review earnings and deductions for a selected pay period.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-cash-stack" aria-hidden="true"></i>
            Payroll report
        </p>
    </header>

    <section class="card dashboard-panel" aria-labelledby="payroll-period-heading">
        <div class="card-header">
            <div class="dashboard-panel-header">
                <i class="bi bi-calendar-range" aria-hidden="true"></i>
                <div>
                    <h2 id="payroll-period-heading">Pay period</h2>
                    <p>Select a period to view its payroll register.</p>
                </div>
            </div>
        </div>
        <div class="card-body">
            <form method="get">
                <label for="reportPeriod" class="form-label">Payroll period</label>
                <select id="reportPeriod"
                        name="periodId"
                        class="form-select"
                        style="max-width: 420px;"
                        onchange="this.form.submit()">
                    <option value="">-- Select Payroll Period --</option>
                    @foreach (var p in periods!)
                    {
                        <option value="@p.PeriodID" selected="@(p.PeriodID == (int?)ViewBag.SelectedPeriodId)">
                            @p.PeriodStart.ToString("MMM dd") - @p.PeriodEnd.ToString("MMM dd, yyyy") (@p.Status)
                        </option>
                    }
                </select>
            </form>
        </div>
    </section>

    @if (Model.Any())
    {
        <section class="card dashboard-panel" aria-labelledby="payroll-results-heading">
            <div class="card-header">
                <div class="dashboard-panel-header">
                    <i class="bi bi-table" aria-hidden="true"></i>
                    <div>
                        <h2 id="payroll-results-heading">Payroll breakdown</h2>
                        <p>Pay and deductions for each employee in this period.</p>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Employee</th>
                            <th scope="col">Basic Pay</th>
                            <th scope="col">OT Pay</th>
                            <th scope="col">Gross Pay</th>
                            <th scope="col">SSS</th>
                            <th scope="col">PhilHealth</th>
                            <th scope="col">Pag-IBIG</th>
                            <th scope="col">Tax</th>
                            <th scope="col">Total Deductions</th>
                            <th scope="col" class="pe-4">Net Pay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@p.Employee?.FirstName @p.Employee?.LastName</td>
                                <td>₱@p.BasicPay.ToString("N2")</td>
                                <td>₱@p.OvertimePay.ToString("N2")</td>
                                <td>₱@p.GrossPay.ToString("N2")</td>
                                <td>₱@p.SSSDeduction.ToString("N2")</td>
                                <td>₱@p.PhilHealthDeduction.ToString("N2")</td>
                                <td>₱@p.PagIBIGDeduction.ToString("N2")</td>
                                <td>₱@p.WithholdingTax.ToString("N2")</td>
                                <td>₱@p.TotalDeductions.ToString("N2")</td>
                                <td class="pe-4 fw-semibold">₱@p.NetPay.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td class="ps-4">TOTAL</td>
                            <td>₱@Model.Sum(p => p.BasicPay).ToString("N2")</td>
                            <td>₱@Model.Sum(p => p.OvertimePay).ToString("N2")</td>
                            <td>₱@Model.Sum(p => p.GrossPay).ToString("N2")</td>
                            <td>₱@Model.Sum(p => p.SSSDeduction).ToString("N2")</td>
                            <td>₱@Model.Sum(p => p.PhilHealthDeduction).ToString("N2")</td>
                            <td>₱@Model.Sum(p => p.PagIBIGDeduction).ToString("N2")</td>
                            <td>₱@Model.Sum(p => p.WithholdingTax).ToString("N2")</td>
                            <td>₱@Model.Sum(p => p.TotalDeductions).ToString("N2")</td>
                            <td class="pe-4">₱@Model.Sum(p => p.NetPay).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>
    }

    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back to Reports
        </a>
    </div>
</div>