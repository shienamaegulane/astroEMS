@{
    ViewData["Title"] = "Reports";
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Insights</p>
            <h1>Reports</h1>
            <p class="dashboard-intro-description">
                Explore employee, attendance, and payroll records.
            </p>
        </div>
        <p class="dashboard-intro-date">
            <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
            3 reports
        </p>
    </header>

    <section aria-labelledby="reports-heading">
        <h2 id="reports-heading" class="visually-hidden">Available reports</h2>

        <div class="row g-3">
            <div class="col-md-6 col-xl-4">
                <article class="card dashboard-panel h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="dashboard-stat-icon mb-3">
                            <i class="bi bi-people" aria-hidden="true"></i>
                        </div>
                        <h3 class="fs-5 mb-2">Employee Master List</h3>
                        <p class="text-muted mb-4">
                            Complete list of employees with their department, position, and status.
                        </p>
                        <a asp-action="EmployeeMasterList"
                           class="btn btn-outline-primary mt-auto align-self-start">
                            View report
                            <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            </div>

            <div class="col-md-6 col-xl-4">
                <article class="card dashboard-panel h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="dashboard-stat-icon mb-3">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                        </div>
                        <h3 class="fs-5 mb-2">Attendance Summary</h3>
                        <p class="text-muted mb-4">
                            Present, late, and absent counts per employee for a selected date range.
                        </p>
                        <a asp-action="AttendanceSummaryReport"
                           class="btn btn-outline-primary mt-auto align-self-start">
                            View report
                            <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            </div>

            <div class="col-md-6 col-xl-4">
                <article class="card dashboard-panel h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="dashboard-stat-icon mb-3">
                            <i class="bi bi-cash-stack" aria-hidden="true"></i>
                        </div>
                        <h3 class="fs-5 mb-2">Payroll Register</h3>
                        <p class="text-muted mb-4">
                            Review the payroll breakdown for a selected pay period.
                        </p>
                        <a asp-action="PayrollRegister"
                           class="btn btn-outline-primary mt-auto align-self-start">
                            View report
                            <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </section>
</div>