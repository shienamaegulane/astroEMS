@model astroEMS.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<section class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Workforce directory</p>
            <h1>Delete Employee</h1>
            <p class="dashboard-intro-description">
                Review the employee record before confirming deletion.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Employees
        </a>
    </header>

    <div class="card">
        <div class="card-header dashboard-panel-header">
            <i class="bi bi-exclamation-triangle text-danger" aria-hidden="true"></i>
            <div>
                <h2>Confirm Deletion</h2>
                <p>This action will delete the selected employee record.</p>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-danger" role="alert">
                Are you sure you want to delete
                <strong>@Model.FirstName @Model.LastName</strong>?
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-4 col-lg-3">Employee number</dt>
                <dd class="col-sm-8 col-lg-9">@Model.EmployeeNumber</dd>

                <dt class="col-sm-4 col-lg-3">Name</dt>
                <dd class="col-sm-8 col-lg-9">@Model.FirstName @Model.LastName</dd>

                <dt class="col-sm-4 col-lg-3">Department</dt>
                <dd class="col-sm-8 col-lg-9">@Model.Department</dd>

                <dt class="col-sm-4 col-lg-3">Position</dt>
                <dd class="col-sm-8 col-lg-9">@Model.Position</dd>

                <dt class="col-sm-4 col-lg-3">Employment status</dt>
                <dd class="col-sm-8 col-lg-9">@Model.EmploymentStatus</dd>
            </dl>

            <form asp-action="Delete" class="d-flex flex-wrap justify-content-end gap-2">
                <input type="hidden" asp-for="EmployeeID" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <input type="submit" value="Delete Employee" class="btn btn-danger" />
            </form>
        </div>
    </div>
</section>