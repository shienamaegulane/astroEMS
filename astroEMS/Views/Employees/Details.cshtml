@model astroEMS.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<section class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Workforce directory</p>
            <h1>Employee Details</h1>
            <p class="dashboard-intro-description">
                @Model.FirstName @Model.LastName · @Model.EmployeeNumber
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Employees
        </a>
    </header>

    <div class="card">
        <div class="card-header dashboard-panel-header">
            <i class="bi bi-person-badge" aria-hidden="true"></i>
            <div>
                <h2>Personal Information</h2>
                <p>Identity and contact details.</p>
            </div>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 col-lg-3">Employee number</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.EmployeeNumber)</dd>

                <dt class="col-sm-4 col-lg-3">First name</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.FirstName)</dd>

                <dt class="col-sm-4 col-lg-3">Last name</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.LastName)</dd>

                <dt class="col-sm-4 col-lg-3">Middle name</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.MiddleName)</dd>

                <dt class="col-sm-4 col-lg-3">Gender</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Gender)</dd>

                <dt class="col-sm-4 col-lg-3">Date of birth</dt>
                <dd class="col-sm-8 col-lg-9">@Model.DateOfBirth?.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4 col-lg-3">Contact number</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.ContactNumber)</dd>

                <dt class="col-sm-4 col-lg-3">Email</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Email)</dd>

                <dt class="col-sm-4 col-lg-3">Address</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Address)</dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header dashboard-panel-header">
            <i class="bi bi-briefcase" aria-hidden="true"></i>
            <div>
                <h2>Employment Details</h2>
                <p>Role, dates, status, and salary.</p>
            </div>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 col-lg-3">Department</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Department)</dd>

                <dt class="col-sm-4 col-lg-3">Position</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Position)</dd>

                <dt class="col-sm-4 col-lg-3">Date hired</dt>
                <dd class="col-sm-8 col-lg-9">@Model.DateHired.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4 col-lg-3">Employment status</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.EmploymentStatus)</dd>

                <dt class="col-sm-4 col-lg-3">Employment type</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.EmploymentType)</dd>

                <dt class="col-sm-4 col-lg-3">Basic salary</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.BasicSalary)</dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header dashboard-panel-header">
            <i class="bi bi-card-checklist" aria-hidden="true"></i>
            <div>
                <h2>Government Information</h2>
                <p>Employee identification numbers.</p>
            </div>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 col-lg-3">SSS number</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.SSSNumber)</dd>

                <dt class="col-sm-4 col-lg-3">PhilHealth number</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.PhilHealthNumber)</dd>

                <dt class="col-sm-4 col-lg-3">Pag-IBIG number</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.PagIBIGNumber)</dd>

                <dt class="col-sm-4 col-lg-3">TIN number</dt>
                <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.TINNumber)</dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header dashboard-panel-header">
            <i class="bi bi-clock-history" aria-hidden="true"></i>
            <div>
                <h2>Record History</h2>
                <p>Creation and update details.</p>
            </div>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 col-lg-3">Date created</dt>
                <dd class="col-sm-8 col-lg-9">@Model.DateCreated.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4 col-lg-3">Date updated</dt>
                <dd class="col-sm-8 col-lg-9">@Model.DateUpdated?.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4 col-lg-3">Created by</dt>
                <dd class="col-sm-8 col-lg-9">@(string.IsNullOrEmpty(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>

                <dt class="col-sm-4 col-lg-3">Last updated by</dt>
                <dd class="col-sm-8 col-lg-9">@(string.IsNullOrEmpty(Model.UpdatedBy) ? "—" : Model.UpdatedBy)</dd>
            </dl>
        </div>
    </div>
</section>