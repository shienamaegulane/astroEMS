@model astroEMS.Models.Employee

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Employee</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EmployeeNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EmployeeNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FirstName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FirstName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LastName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LastName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.MiddleName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.MiddleName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Gender)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Gender)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DateOfBirth)</dt>
        <dd class="col-sm-10">@Model.DateOfBirth?.ToString("MMM dd, yyyy")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ContactNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Address)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Address)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Department)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Department)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Position)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Position)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DateHired)</dt>
        <dd class="col-sm-10">@Model.DateHired.ToString("MMM dd, yyyy")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EmploymentStatus)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EmploymentStatus)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EmploymentType)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EmploymentType)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.BasicSalary)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.BasicSalary)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.SSSNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SSSNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PhilHealthNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PhilHealthNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PagIBIGNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PagIBIGNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TINNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TINNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DateCreated)</dt>
        <dd class="col-sm-10">@Model.DateCreated.ToString("MMM dd, yyyy")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DateUpdated)</dt>
        <dd class="col-sm-10">@Model.DateUpdated?.ToString("MMM dd, yyyy")</dd>

        <dt class="col-sm-2">Created By</dt>
        <dd class="col-sm-10">@(string.IsNullOrEmpty(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>

        <dt class="col-sm-2">Last Updated By</dt>
        <dd class="col-sm-10">@(string.IsNullOrEmpty(Model.UpdatedBy) ? "—" : Model.UpdatedBy)</dd>
    </dl>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>