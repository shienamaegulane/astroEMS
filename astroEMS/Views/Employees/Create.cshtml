@model astroEMS.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<section class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Workforce directory</p>
            <h1>Add Employee</h1>
            <p class="dashboard-intro-description">
                Create a new employee record and enter their employment details.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Employees
        </a>
    </header>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-4">
            <div class="card-header dashboard-panel-header">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
                <div>
                    <h2>Personal Information</h2>
                    <p>Basic details and contact information.</p>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                    Employee ID: <strong>@ViewBag.NextEmployeeNumber</strong>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">First name</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">Last name</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MiddleName" class="form-label">Middle name</label>
                        <input asp-for="MiddleName" class="form-control" />
                        <span asp-validation-for="MiddleName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label">Gender</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label">Date of birth</label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactNumber" class="form-label">Contact number</label>
                        <input asp-for="ContactNumber" class="form-control" />
                        <span asp-validation-for="ContactNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header dashboard-panel-header">
                <i class="bi bi-briefcase" aria-hidden="true"></i>
                <div>
                    <h2>Employment Details</h2>
                    <p>Department, position, start date, and status.</p>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label">Department</label>
                        <select asp-for="Department" id="departmentSelect"
                                class="form-select" asp-items="ViewBag.Departments">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Position" class="form-label">Position</label>
                        <select asp-for="Position" id="positionSelect" class="form-select">
                            <option value="">-- Select Department First --</option>
                        </select>
                        <span asp-validation-for="Position" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateHired" class="form-label">Date hired</label>
                        <input asp-for="DateHired" class="form-control" type="date" />
                        <span asp-validation-for="DateHired" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmploymentStatus" class="form-label">Employment status</label>
                        <select asp-for="EmploymentStatus" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Resigned">Resigned</option>
                            <option value="Terminated">Terminated</option>
                            <option value="On Leave">On Leave</option>
                        </select>
                        <span asp-validation-for="EmploymentStatus" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmploymentType" class="form-label">Employment type</label>
                        <select asp-for="EmploymentType" class="form-select">
                            <option value="Regular">Regular</option>
                            <option value="Probationary">Probationary</option>
                            <option value="Contractual">Contractual</option>
                        </select>
                        <span asp-validation-for="EmploymentType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BasicSalary" class="form-label">Basic salary</label>
                        <input asp-for="BasicSalary" class="form-control" />
                        <span asp-validation-for="BasicSalary" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header dashboard-panel-header">
                <i class="bi bi-card-checklist" aria-hidden="true"></i>
                <div>
                    <h2>Government Information</h2>
                    <p>Record the employee’s identification numbers.</p>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SSSNumber" class="form-label">SSS number</label>
                        <input asp-for="SSSNumber" class="form-control" />
                        <span asp-validation-for="SSSNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhilHealthNumber" class="form-label">PhilHealth number</label>
                        <input asp-for="PhilHealthNumber" class="form-control" />
                        <span asp-validation-for="PhilHealthNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PagIBIGNumber" class="form-label">Pag-IBIG number</label>
                        <input asp-for="PagIBIGNumber" class="form-control" />
                        <span asp-validation-for="PagIBIGNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TINNumber" class="form-label">TIN number</label>
                        <input asp-for="TINNumber" class="form-control" />
                        <span asp-validation-for="TINNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <input type="submit" value="Create Employee" class="btn btn-gold" />
        </div>
    </form>
</section>

@section Scripts {
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                const deptSelect = document.getElementById('departmentSelect');
                const posSelect = document.getElementById('positionSelect');
                const currentPosition = "@Model?.Position"; // preserves selection on Edit

                // Map department NAME -> DepartmentID, since Employee.Department stores text
                const departmentMap = {
                                        @foreach (var d in (IEnumerable<astroEMS.Models.Department>)ViewBag.AllDepartments)
                    {
                                @:"@d.Name": @d.DepartmentID,
                }
                                    };

            function loadPositions(departmentName, selectedValue) {
                posSelect.innerHTML = '<option value="">-- Select Position --</option>';
                const deptId = departmentMap[departmentName];
                if (!deptId) return;

                fetch('/Positions/GetByDepartment?departmentId=' + deptId)
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(p => {
                            const opt = document.createElement('option');
                            opt.value = p.name;
                            opt.textContent = p.name;
                            if (p.name === selectedValue) opt.selected = true;
                            posSelect.appendChild(opt);
                        });
                    });
            }

            deptSelect.addEventListener('change', function() {
                loadPositions(this.value, null);
            });

            // On page load (Edit form), pre-filter based on existing Department value
            if (deptSelect.value) {
                loadPositions(deptSelect.value, currentPosition);
            }
        });
    </script>
}