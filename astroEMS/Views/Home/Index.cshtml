@model astroEMS.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">
    <header class="dashboard-intro">
        <div>
            <p class="dashboard-intro-label">Attendance &amp; Payroll Management</p>
            <h1>Operations Overview</h1>
            <p class="dashboard-intro-description">
                Workforce and daily attendance at a glance.
            </p>
        </div>

        <p class="dashboard-intro-date">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <time datetime="@DateTime.Today.ToString("yyyy-MM-dd")">
                @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </time>
        </p>
    </header>

    <section class="dashboard-metrics" aria-label="Workforce and attendance metrics">
        <div class="dashboard-stat">
            <div class="dashboard-stat-top">
                <p class="dashboard-stat-label">Total Employees</p>
                <span class="dashboard-stat-icon">
                    <i class="bi bi-people" aria-hidden="true"></i>
                </span>
            </div>
            <strong class="dashboard-stat-value">@Model.TotalEmployees</strong>
        </div>

        <div class="dashboard-stat dashboard-stat--positive">
            <div class="dashboard-stat-top">
                <p class="dashboard-stat-label">Active</p>
                <span class="dashboard-stat-icon">
                    <i class="bi bi-person-check" aria-hidden="true"></i>
                </span>
            </div>
            <strong class="dashboard-stat-value">@Model.ActiveEmployees</strong>
        </div>

        <div class="dashboard-stat dashboard-stat--positive">
            <div class="dashboard-stat-top">
                <p class="dashboard-stat-label">Present Today</p>
                <span class="dashboard-stat-icon">
                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                </span>
            </div>
            <strong class="dashboard-stat-value">@Model.PresentToday</strong>
        </div>

        <div class="dashboard-stat dashboard-stat--caution">
            <div class="dashboard-stat-top">
                <p class="dashboard-stat-label">Late Today</p>
                <span class="dashboard-stat-icon">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                </span>
            </div>
            <strong class="dashboard-stat-value">@Model.LateToday</strong>
        </div>

        <div class="dashboard-stat dashboard-stat--negative">
            <div class="dashboard-stat-top">
                <p class="dashboard-stat-label">Absent Today</p>
                <span class="dashboard-stat-icon">
                    <i class="bi bi-person-x" aria-hidden="true"></i>
                </span>
            </div>
            <strong class="dashboard-stat-value">@Model.AbsentToday</strong>
        </div>

        <div class="dashboard-stat dashboard-stat--pending">
            <div class="dashboard-stat-top">
                <p class="dashboard-stat-label">Pending COE</p>
                <span class="dashboard-stat-icon">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                </span>
            </div>
            <strong class="dashboard-stat-value">@Model.PendingCOERequests</strong>
        </div>
    </section>

    @if (Model.Alerts.Any())
    {
        <section class="card dashboard-panel" aria-labelledby="dashboard-alerts-heading">
            <div class="card-header dashboard-panel-header">
                <i class="bi bi-exclamation-diamond" aria-hidden="true"></i>
                <div>
                    <h2 id="dashboard-alerts-heading">Alerts</h2>
                    <p>Items that may need attention</p>
                </div>
            </div>

            <div class="dashboard-alert-list">
                @foreach (var alert in Model.Alerts.Take(2))
                {
                    <div class="dashboard-alert-item">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>@alert</span>
                    </div>
                }
            </div>
        </section>
    }

    <div class="dashboard-panel-grid">
        <section class="card dashboard-panel" aria-labelledby="dashboard-departments-heading">
            <div class="card-header dashboard-panel-header">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                <div>
                    <h2 id="dashboard-departments-heading">Department Overview</h2>
                    <p>Employees by department</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Department</th>
                            <th scope="col">Employees</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DepartmentBreakdown.Any())
                        {
                            @foreach (var d in Model.DepartmentBreakdown)
                            {
                                <tr>
                                    <th scope="row">@d.Department</th>
                                    <td>@d.Count</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="dashboard-empty">
                                    No department data available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card dashboard-panel" aria-labelledby="dashboard-employment-heading">
            <div class="card-header dashboard-panel-header">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
                <div>
                    <h2 id="dashboard-employment-heading">Employment Type</h2>
                    <p>Current workforce composition</p>
                </div>
            </div>

            <ul class="dashboard-employment">
                <li>
                    <span>Regular</span>
                    <strong>@Model.RegularEmployees</strong>
                </li>
                <li>
                    <span>Probationary</span>
                    <strong>@Model.ProbationaryEmployees</strong>
                </li>
                <li>
                    <span>Contractual</span>
                    <strong>@Model.ContractualEmployees</strong>
                </li>
            </ul>
        </section>
    </div>

    <section class="card dashboard-panel" aria-labelledby="dashboard-actions-heading">
        <div class="card-header dashboard-panel-header">
            <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            <div>
                <h2 id="dashboard-actions-heading">Quick Actions</h2>
                <p>Common workforce tasks</p>
            </div>
        </div>

        <div class="card-body dashboard-quick-actions">
            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <a asp-controller="Employees" asp-action="Create"
                   class="btn btn-primary btn-sm">
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    Add Employee
                </a>

                <a asp-controller="Attendance" asp-action="Import"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-upload" aria-hidden="true"></i>
                    Import Attendance
                </a>

                <a asp-controller="Payroll" asp-action="GeneratePayroll"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-cash-stack" aria-hidden="true"></i>
                    Generate Payroll
                </a>

                <a asp-controller="COE" asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
                    COE Requests
                </a>
            }

            <a asp-controller="Attendance" asp-action="Summary"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                Attendance Summary
            </a>
        </div>
    </section>
</div>